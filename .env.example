# ============================================================
# SwapTest — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Database (Neon / Supabase PostgreSQL) ──────────────────
DATABASE_URL="postgresql://user:password@host:5432/swaptest?sslmode=require"

# ── Authentication ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-here-min-32-chars"

# ── Stripe ─────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID for the £3 platform fee (create in Stripe Dashboard → Products)
STRIPE_PRICE_ID="price_..."

# ── Resend (Email) ─────────────────────────────────────────
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY="re_..."
# The "from" address (must be verified domain in Resend)
EMAIL_FROM="SwapTest <noreply@swaptest.co.uk>"
# Inbox that contact-form submissions are sent to (defaults to hello@swaptest.co.uk)
CONTACT_TO_EMAIL="hello@swaptest.co.uk"

# ── Upstash (Rate Limiting + Cron) ─────────────────────────
# Dashboard: https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."
QSTASH_TOKEN="..."
# The base URL of your deployed app (used for QStash callbacks)
QSTASH_CURRENT_SIGNING_KEY="sig_..."
QSTASH_NEXT_SIGNING_KEY="sig_..."

# ── App Config ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Master payments switch. Only when set to exactly "true" is the £1/week
# membership charged. Anything else (or unset) = free mode: nobody is gated,
# nothing touches Stripe, and the UI shows "free".
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
# NOTE: the one-time £1 registration fee and the £8 swap fee are both retired.
# The model is now a £1/week membership with a 7 day trial, gating one action:
# asking another learner for a swap. Listing a test and accepting a request are
# free. The amount and trial length are constants in lib/subscription.js, and
# the weekly price is created inline at checkout, so there is no Stripe Price ID
# to configure. REGISTRATION_FEE_PENCE and SWAP_FEE_PENCE are no longer read.
#
# Before setting NEXT_PUBLIC_PAYMENTS_ENABLED=true you must:
#   1. Run prisma/manual-migrations/006_subscription_default.sql in Neon.
#      Without it every new signup inherits lifetimeFreeAccess=true and the
#      membership gates nobody.
#   2. Add the Stripe webhook endpoint (see STRIPE_WEBHOOK_SECRET below) and
#      subscribe it to: checkout.session.completed,
#      customer.subscription.created, customer.subscription.updated,
#      customer.subscription.deleted, invoice.payment_failed.
#   3. Enable the Stripe billing portal, otherwise "Manage membership" fails.
# NOTE: SWAP_DEADLINE_HOURS used to live here and is no longer read. The window
# is now a constant in lib/swap-window.js, because the same number appears in the
# homepage, the FAQ, the dashboard and three emails, and none of those can read a
# server-side env var. Setting it here would change behaviour and leave the copy
# saying something else. Change it in lib/swap-window.js and deploy.

# ── Google Analytics 4 (optional) ──────────────────────────
# The Measurement ID from your GA4 property, e.g. G-XXXXXXXXXX.
# Leave unset and no analytics code is included at all, which is what you want
# locally and on preview deployments so test traffic never reaches the property.
#
# Two things to know:
#  - It is inlined at build time, like every NEXT_PUBLIC_ value, so setting it
#    in Vercel does nothing until the next deployment.
#  - Even with it set, nothing loads until a visitor presses "Accept all" on the
#    cookie banner. That is a hard gate, not Google's Consent Mode: no script,
#    no request to Google, no cookie.
NEXT_PUBLIC_GA_ID=""

# ── Cron Secret (protect the /api/cron/* endpoints) ────────
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"
