# ============================================================
# SwapTest — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Database (Neon / Supabase PostgreSQL) ──────────────────
DATABASE_URL="postgresql://user:password@host:5432/swaptest?sslmode=require"

# ── Authentication ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-here-min-32-chars"

# ── Stripe ─────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Dashboard → Developers → Webhooks → Signing secret
# The endpoint (/api/payments/webhook) must subscribe to these events:
#   checkout.session.completed, invoice.paid, invoice.payment_failed,
#   customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Resend (Email) ─────────────────────────────────────────
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY="re_..."
# The "from" address (must be verified domain in Resend)
EMAIL_FROM="SwapTest <noreply@swaptest.co.uk>"
# Inbox that contact-form submissions are sent to (defaults to hello@swaptest.co.uk)
CONTACT_TO_EMAIL="hello@swaptest.co.uk"

# ── Upstash (Rate Limiting + Cron) ─────────────────────────
# Dashboard: https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."
QSTASH_TOKEN="..."
# The base URL of your deployed app (used for QStash callbacks)
QSTASH_CURRENT_SIGNING_KEY="sig_..."
QSTASH_NEXT_SIGNING_KEY="sig_..."

# ── App Config ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Master payments switch. Only when set to exactly "true" is the £1/week
# membership enforced. Anything else (or unset) = free mode: listing a test and
# swapping work without any charge, Stripe is never called, and the UI shows
# "free".
NEXT_PUBLIC_PAYMENTS_ENABLED="false"

# ── Membership (£1 per week) ───────────────────────────────
# Weekly membership price in pence. 100 = £1.00.
# Only used when STRIPE_WEEKLY_PRICE_ID is unset (the price is then built inline).
SUBSCRIPTION_PENCE_PER_WEEK=100
# Preferred: a recurring weekly Price created in the Stripe dashboard.
# Leave blank to have the app build the price from SUBSCRIPTION_PENCE_PER_WEEK.
STRIPE_WEEKLY_PRICE_ID=""
# NOTE: there is no "grandfathering" env var. Free-for-life access is stored per
# user in the database (User.lifetimeFreeAccess), so it cannot be lost to a
# missing or mistyped config value. Everyone who signs up while the site is free
# becomes a founding member automatically. See
# prisma/manual-migrations/004_lifetime_free_access.sql for the one statement to
# run at paid launch.

# Hours a match stays open for both parties to agree
SWAP_DEADLINE_HOURS=24

# ── Cron Secret (protect the /api/cron/* endpoints) ────────
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"
