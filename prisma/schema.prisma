// ============================================================
// SwapTest — Database Schema (Prisma)
// ============================================================
// Run after changes:
//   npx prisma db push    (dev — applies directly)
//   npx prisma migrate dev (prod — creates migration file)
//   npx prisma generate    (regenerates the client)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  password     String   // bcrypt hash
  tokenVersion Int      @default(0) // bumped on password reset to invalidate all existing JWTs

  // ── Subscription (£1/week) ──
  // Access to listing a test and starting a swap is gated on an active
  // subscription. See lib/subscription.js for the single source of truth on
  // what counts as "active".
  stripeCustomerId     String?            @unique // Stripe Customer, created on first checkout
  stripeSubscriptionId String?            @unique // the current/most recent subscription
  subscriptionStatus   SubscriptionStatus @default(NONE)
  subscriptionCurrentPeriodEnd DateTime?  // access runs until this instant, even after cancelling

  // Founding members: permanent free access, no subscription ever required.
  //
  // The default is TRUE on purpose. Every user who signs up while the site is
  // free is a founding member and keeps free access for life. At paid launch
  // this default is flipped to FALSE (see prisma/manual-migrations/004), so only
  // users onboarded AFTER that point ever pay. Existing rows are never changed.
  //
  // Getting the flip wrong leaks revenue rather than locking anyone out — the
  // deliberately safe direction to fail in.
  lifetimeFreeAccess Boolean @default(true)

  // HISTORICAL: set for users who paid the old one-time £1 registration fee.
  // No longer affects access (those users are founding members via the flag
  // above). Kept for the record only.
  registrationPaidAt DateTime?

  pushToken    String?  // APNs device token for push notifications
  pushPlatform String?  // "ios" or "android"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings        Listing[]
  matchesAsEarlier Match[] @relation("EarlierUser")
  matchesAsLater   Match[] @relation("LaterUser")
  payments        Payment[]

  @@index([email])
  @@index([subscriptionStatus, subscriptionCurrentPeriodEnd]) // matching filters on this
}

// Mirrors the Stripe subscription states we care about.
enum SubscriptionStatus {
  NONE      // never subscribed
  ACTIVE    // paying; renews weekly
  PAST_DUE  // a renewal failed; Stripe is retrying. Access holds until the period end.
  CANCELLED // ended (by the user or after failed retries)
}

// ── Listings ──────────────────────────────────────────────

enum ListingType {
  EARLIER  // user wants an earlier date
  LATER    // user wants a later date (willing to swap for later)
}

enum TestType {
  WEEKDAY          // weekday test (£62)
  EVENING_WEEKEND  // evening, weekend or bank holiday test (£75)
}

enum ListingStatus {
  AVAILABLE  // open for matching
  LOCKED     // someone selected this, pending confirmation
  MATCHED    // fully matched and paid
  EXPIRED    // match timed out, back in pool
  CANCELLED  // user cancelled their listing
}

model Listing {
  id                String        @id @default(cuid())
  userId            String
  type              ListingType
  centre            String        // exact DVSA test centre name
  testType          TestType      @default(WEEKDAY) // must match for a swap (DVSA rule)
  originalCentre    String?       // if they swapped before, the centre they can move back to
  currentDate       DateTime      // user's existing test date
  currentTime       String        // e.g. "09:30"
  status            ListingStatus @default(AVAILABLE)
  lockedByMatchId   String?       // which match locked this listing
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id])
  matchesAsEarlier  Match[]       @relation("EarlierListing")
  matchesAsLater    Match[]       @relation("LaterListing")

  @@index([centre, type, status])    // primary matching query
  @@index([userId])
  @@index([status])
}

// ── Matches ───────────────────────────────────────────────

enum MatchStatus {
  PENDING      // matched; awaiting both parties' consent
  COMPLETED    // both consented and earlier paid — contact details exchanged
  EXPIRED      // not completed before payDeadline
  DECLINED     // a party declined
  CANCELLED    // admin or system cancelled
}

model Match {
  id                String      @id @default(cuid())

  earlierUserId     String
  laterUserId       String
  earlierListingId  String
  laterListingId    String
  initiatedByUserId String      // who clicked "Select"

  status            MatchStatus @default(PENDING)

  // Consent — both parties must accept the data-sharing disclaimer before contact exchange
  earlierConsentAt  DateTime?
  laterConsentAt    DateTime?

  // LEGACY: the old £8 per-swap fee. Swaps are now covered by the weekly
  // subscription and nothing is charged here. Retained so historic matches keep
  // their payment record and stay refundable.
  earlierPaid       Boolean     @default(false)
  earlierPaymentId  String?     // Stripe PaymentIntent ID

  // Single completion deadline (absolute timestamp)
  payDeadline       DateTime?

  // Metadata
  createdAt         DateTime    @default(now())
  completedAt       DateTime?
  expiredAt         DateTime?

  // Relations
  earlierUser       User        @relation("EarlierUser", fields: [earlierUserId], references: [id])
  laterUser         User        @relation("LaterUser", fields: [laterUserId], references: [id])
  earlierListing    Listing     @relation("EarlierListing", fields: [earlierListingId], references: [id])
  laterListing      Listing     @relation("LaterListing", fields: [laterListingId], references: [id])
  payments          Payment[]

  @@index([status])
  @@index([payDeadline])
}

// ── Payments ──────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCEEDED
  REFUNDED
  FAILED
}

model Payment {
  id                String        @id @default(cuid())
  purpose           String        @default("subscription") // "subscription" | legacy: "registration" | "swap"
  matchId           String?       // only ever set on legacy "swap" payments
  userId            String
  amountPence       Int           // e.g. 100 = £1.00 weekly subscription
  stripeSessionId   String?       @unique // Stripe Checkout Session ID
  stripePaymentId   String?       // Stripe PaymentIntent ID
  status            PaymentStatus @default(PENDING)
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())

  match             Match?        @relation(fields: [matchId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@index([stripeSessionId])
  @@index([matchId])
}
